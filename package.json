{
  "name": "webhook-signature-companion",
  "displayName": "Webhook Signature Companion",
  "description": "Computes and verifies HMAC webhook signatures (GitHub/generic sha1/sha256/sha512) against a payload+secret, right in the editor. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "webhook",    "hmac",    "signature",    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-webhook-signature-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-webhook-signature-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "webhookSignatureCompanion.open",
        "title": "Webhook Signature Companion: Compute & Verify"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
